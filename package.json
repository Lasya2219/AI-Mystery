{
  "name": "ai-mystery-room",
  "private": true,
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently -k -n server,client -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "npm --workspace client run dev",
    "dev:server": "npm --workspace server run dev",
    "build": "npm --workspace server run build && npm --workspace client run build",
    "test": "npm --workspace server test && npm --workspace client run build"
  },
  "devDependencies": { "concurrently": "^9.1.2", "typescript": "^5.7.3" }
}
